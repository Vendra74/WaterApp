# Copie para .env (não versionado). Nenhuma chave secreta deve entrar no app.
# A "anon key" do Supabase é pública por design; a segurança vem das políticas RLS no servidor.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Ativa o modo de demonstração com dados fictícios claramente identificados (true/false).
EXPO_PUBLIC_DEMO_MODE=false

# Identificador do projeto EAS (opcional; o padrão já está em app.config.ts).
EAS_PROJECT_ID=
